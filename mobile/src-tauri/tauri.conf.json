{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BZtune Android Teste",
  "version": "0.4.0",
  "identifier": "com.bztune.android.preview",
  "build": {
    "beforeDevCommand": "npm --prefix ../doomvault run dev:android -- --host 0.0.0.0",
    "devUrl": "http://localhost:1420/mobile.html",
    "beforeBuildCommand": "npm --prefix ../doomvault run build:android",
    "frontendDist": "../../doomvault/dist-mobile"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BZtune",
        "width": 412,
        "height": 820,
        "url": "mobile.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 24
    }
  }
}
